#include <winver.h>

1 VERSIONINFO
FILEVERSION 3,0,0,0
PRODUCTVERSION 3,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "First Person Explorer project"
            VALUE "FileDescription", "True First-Person Camera - DX11 render bridge, instant scale, full-body camera"
            VALUE "FileVersion", "3.0.0.0"
            VALUE "InternalName", "FirstPersonExplorerNative"
            VALUE "OriginalFilename", "FirstPersonExplorerNative.dll"
            VALUE "ProductName", "First Person Explorer"
            VALUE "ProductVersion", "3.0.0.0"
            VALUE "Comments", "Open source: https://github.com/Proteusproject1/FirstPersonExplorer"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
