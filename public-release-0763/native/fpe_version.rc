            VALUE "ProductName", "First Person Explorer"
            VALUE "ProductVersion", "0.7.6.7"
            VALUE "Comments", "Open source: https://github.com/Proteusproject1/FirstPersonExplorer"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
