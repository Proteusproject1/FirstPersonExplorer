        BEGIN
            VALUE "CompanyName", "First Person Explorer project"
            VALUE "FileDescription", "First Person Explorer DX11 render bridge for Baldur's Gate 3 (Native Mod Loader plugin)"
            VALUE "FileVersion", "0.7.6.7"
            VALUE "InternalName", "FirstPersonExplorerNative"
